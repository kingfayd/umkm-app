generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Procurement {
  id              Int              @id @default(autoincrement())
  category        String
  itemName        String
  unitPrice       Decimal          @db.Decimal(12, 2)
  totalPrice      Decimal          @db.Decimal(12, 2)
  unit            String?
  supplierName    String?
  purchaseDate    DateTime
  initialQuantity Int              @default(0)
  currentQuantity Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          Int
  user            User             @relation(fields: [userId], references: [id])
  productionItems ProductionItem[]

}


// Model pengguna
model User {
  id        Int          @id @default(autoincrement())
  username  String       @unique
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  procurements Procurement[]
  productions Production[]
  sales       Sale[]
}

model Production {
  id                 Int              @id @default(autoincrement())
  productName        String
  productionDate     DateTime
  productionQuantity Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  userId             Int
  user               User             @relation(fields: [userId], references: [id])

  // Relasi ke ProductionItem
  items              ProductionItem[]
  saleItems          SaleItem[]
}

model ProductionItem {
  id            Int         @id @default(autoincrement())
  quantity      Int
  production    Production  @relation(fields: [productionId], references: [id])
  productionId  Int
  procurement   Procurement @relation(fields: [procurementId], references: [id])
  procurementId Int
}

model Sale {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  totalAmount Decimal    @db.Decimal(12, 2)
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  items       SaleItem[]
}

model SaleItem {
  id           Int       @id @default(autoincrement())
  productName  String
  quantity     Int
  unitPrice    Decimal   @db.Decimal(12, 2)
  saleId       Int
  sale         Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productionId Int
  production   Production @relation(fields: [productionId], references: [id], onDelete: Restrict)

  @@unique([saleId, productionId])
}
