generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Procurement {
  id              Int              @id @default(autoincrement())
  category        String
  itemName        String
  unitPrice       Float
  totalPrice      Float
  unit            String?
  supplierName    String?
  purchaseDate    DateTime
  initialQuantity Int              @default(0)
  currentQuantity Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userId          Int
  user            User             @relation(fields: [userId], references: [id])

}

model Production {
  id               Int                     @id @default(autoincrement())
  productName      String
  productionDate   DateTime
  productionQuantity Int                    @default(0) // Set default value
  quantity           Int
  items            ProductionProcurement[] // Relasi ke tabel join
}

model ProductionProcurement {
  id             Int         @id @default(autoincrement())
  productionId   Int
  procurementId  Int
  quantity       Int         // Menyimpan jumlah bahan yang digunakan
  production     Production   @relation(fields: [productionId], references: [id], onDelete: Cascade)
  procurement    Procurement  @relation(fields: [procurementId], references: [id], onDelete: Cascade)

  @@unique([productionId, procurementId]) // Menjamin tidak ada duplikasi relasi
}

// Model pengguna
model User {
  id        Int          @id @default(autoincrement())
  username  String       @unique
  email     String       @unique
  password  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  procurements Procurement[]
  }

