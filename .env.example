# Copy this file to .env locally and replace placeholders with real values.
# Never commit .env or paste real credentials into GitHub or chat.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Use a long, random secret (at least 32 bytes).
JWT_SECRET="replace-with-a-long-random-secret"

# SMTP credentials for password-reset emails.
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-smtp-username"
EMAIL_SERVER_PASSWORD="your-smtp-app-password"
EMAIL_FROM="Your App <no-reply@example.com>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
